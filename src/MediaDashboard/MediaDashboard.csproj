<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net10.0-windows: a versioned TFM pulls in the 25 MB Windows SDK projection (Microsoft.Windows.SDK.NET.dll). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MediaDashboard</AssemblyName>
    <RootNamespace>MediaDashboard</RootNamespace>
    <Version>1.0.1</Version>
    <Product>Media Dashboard</Product>
    <!-- Required by the .NET Library License for redistributed runtime binaries; shown in the exe's file properties. -->
    <Copyright>Copyright (c) 2026 Ramazan Yapparov</Copyright>

    <!-- Single self-contained exe (decision Q27). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- No EnableCompressionInSingleFile: it saves disk only (the release zip is the same ~66 MB) but
         decompresses assemblies into private memory: 119 MB vs 41 MB private working set, slower start. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for NotifyIcon; keep WPF types unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaDashboard.Core\MediaDashboard.Core.csproj" />
    <ProjectReference Include="..\MediaDashboard.Platform\MediaDashboard.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the license texts next to the exe; kept out of the single-file bundle so users can read them. -->
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
